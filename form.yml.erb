<%-
  # Partition list. This app uses the same app-local helper as the QuPath app
  # (ood_partitions.rb, copied into this directory), which applies Slurm's
  # parent-account rule. This first version is CPU-only, so GPU partitions are
  # left out of the list. Without the helper, the fixed list below is used.
  cluster_id = 'cluster'   # SITE: the cluster id (clusters.d file name)
  helper     = File.join(__dir__, 'ood_partitions.rb')

  fallback = [%w[short short], %w[long long], %w[himem himem]]   # SITE

  partitions = fallback
  limits     = {}
  if File.exist?(helper)
    begin
      require helper unless defined?(OodPartitions)
      values = OodPartitions.options(cluster_id: cluster_id).map { |o| o.is_a?(Array) ? o.last.to_s : o.to_s }
      cpu    = values.reject { |name| OodPartitions.gpu?(name, cluster_id: cluster_id) }
      unless cpu.empty?
        partitions = cpu.map { |name| [name, name] }
        limits     = cpu.to_h { |name| [name, OodPartitions.max_hours(name, cluster_id: cluster_id)] }
      end
    rescue StandardError
      partitions = fallback
      limits     = {}
    end
  end
  default_partition = partitions.map(&:last).include?('short') ? 'short' : partitions.first.last
-%>
---
cluster: "<%= cluster_id %>"

attributes:
  partition:
    widget: select
    label: Partition
    value: "<%= default_partition %>"
    help: |
      This app runs on CPU partitions only. The display is rendered and
      streamed on the CPU cores requested below.
    options: <%= partitions.to_json %>
    # Partition time limits (hours) for form.js.
    html_options:
      data:
        max-hours: <%= limits.to_json.to_json %>

  bc_num_hours:
    value: 4
    min: 1
    help: |
      The session ends when this time is reached, or earlier when napari is
      closed.

  num_cores:
    widget: number_field
    label: CPU cores
    value: 8
    min: 4
    max: 32
    step: 1
    help: |
      napari draws its views on the CPU in this app, and the stream is also
      encoded on the CPU, so more cores give a more responsive display. Eight
      suits most Xenium and CosMx datasets; use 16 for whole-slide images with
      many transcripts or cell boundaries, or for Cellpose segmentation,
      which also runs on the CPU here.

  memory_gb:
    widget: number_field
    label: Memory (GB)
    value: 32
    min: 8
    max: 256
    step: 4
    help: |
      SpatialData reads image pyramids lazily, but points (transcripts),
      shapes (cell boundaries) and the table are held in memory once shown.
      32 GB suits a typical CosMx or Xenium slide; allow 64 GB or more for
      multi-slide stores or full transcript layers.

  napari_app:
    widget: select
    label: Viewer
    value: "spatialdata"
    options:
      - ["napari-spatialdata and image analysis plugins (napari 0.10)", "spatialdata"]
      - ["napari-cosmx, Bruker CosMx viewer (napari 0.6.6)", "cosmx"]
    help: |
      The napari-cosmx plugin needs older libraries than napari-spatialdata,
      so it runs in its own napari. It is provided by Bruker Spatial Biology
      under a licence for non-commercial use only
      (<a href="https://www.nanostring.com" target="_blank">nanostring.com</a>).

  dataset:
    widget: path_selector
    label: Data to open (optional)
    directory: "/well"   # SITE: where the file browser opens
    show_hidden: false
    show_files: false
    help: |
      For napari-spatialdata, a SpatialData <code>.zarr</code> store; raw
      Xenium or CosMx output must first be converted with
      <code>spatialdata-io</code>. For napari-cosmx, a napari-cosmx data
      folder. Leave empty to start with an empty viewer and open data from
      <em>File &gt; Open Folder...</em>.

  napari_spatialdata_version:
    widget: hidden_field
    value: "0.7.2-r2"   # SITE: the image version (napari-spatialdata 0.7.2, plugin set 2)

form:
  - partition
  - bc_num_hours
  - num_cores
  - memory_gb
  - napari_app
  - dataset
  - napari_spatialdata_version
  - bc_email_on_started
