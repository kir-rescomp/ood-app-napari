Bootstrap: docker
From: ubuntu:24.04

# napari with the napari-spatialdata plugin and the plugins KIR users have
# requested, streamed to the browser by Selkies, for the Open OnDemand
# napari-spatialdata app. CPU only: OpenGL is rendered by Mesa's llvmpipe,
# the stream is encoded on the CPU, and PyTorch is the CPU-only build.
#
# Two Python environments:
#   /opt/napari-env         napari 0.10, napari-spatialdata and the other plugins
#   /opt/napari-cosmx-env   napari 0.6.6 and Bruker's napari-cosmx, whose
#                           dependencies cannot share the main environment
#
# Build (Apptainer >= 1.2, from this directory, with internet access to
# pypi.org, download.pytorch.org, github.com and huggingface.co):
#   apptainer build napari-spatialdata-selkies_0.7.2-r2.sif napari-spatialdata-selkies.def
#
# The Python packages are pinned in requirements.lock, requirements-torch.txt
# and requirements-cosmx.lock, generated by compile-lock.sh from
# requirements.in and requirements-cosmx.in. To update them, edit the .in
# files, run ./compile-lock.sh, and rebuild under a new image name.

%arguments
    IMAGE_VERSION=0.7.2-r2
    SELKIES_VERSION=2.0.0
    CELLPOSE_MODELS=cpsam_v2

%labels
    org.opencontainers.image.title "napari-spatialdata with Selkies browser streaming"
    org.opencontainers.image.authors "KIR Research Computing"
    image.version {{ IMAGE_VERSION }}
    selkies.version {{ SELKIES_VERSION }}

%files
    requirements.in /opt/napari-selkies/requirements.in
    requirements.lock /opt/napari-selkies/requirements.lock
    requirements-torch.txt /opt/napari-selkies/requirements-torch.txt
    requirements-cosmx.in /opt/napari-selkies/requirements-cosmx.in
    requirements-cosmx.lock /opt/napari-selkies/requirements-cosmx.lock
    overrides.txt /opt/napari-selkies/overrides.txt
    patches /opt/napari-selkies/patches
    napari-session /opt/napari-selkies/bin/napari-session
    napari-spatialdata-start /opt/napari-selkies/bin/napari-spatialdata-start
    openbox-rc.xml /opt/napari-selkies/openbox/rc.xml

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git patch \
        python3.12 python3.12-venv \
        xvfb x11-xserver-utils x11-utils \
        openbox wmctrl dbus \
        libgl1 libegl1 libgl1-mesa-dri libglx-mesa0 mesa-utils \
        libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 \
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
        libxcb-shape0 libxcb-xinerama0 libxcb-xfixes0 libxcb-xkb1 \
        libfontconfig1 libfreetype6 libdbus-1-3 libxtst6 \
        fonts-dejavu-core fonts-liberation \
        locales tzdata

    # Selkies: private Python environment under /opt/selkies, with the web
    # client, the pixelflux encoder and selkies-session on PATH.
    curl -fsSL -o /tmp/selkies.deb \
        "https://github.com/selkies-project/selkies/releases/download/{{ SELKIES_VERSION }}/selkies-{{ SELKIES_VERSION }}-ubuntu24.04-amd64.deb"
    apt-get install -y --no-install-recommends /tmp/selkies.deb
    rm -f /tmp/selkies.deb

    # uv installs the pinned files; it is used only during the build and is
    # not kept in the image.
    python3.12 -m venv /tmp/uv-bootstrap
    /tmp/uv-bootstrap/bin/pip install --quiet uv
    uv=/tmp/uv-bootstrap/bin/uv

    # Main environment. PyTorch (for Cellpose) comes first, as the CPU-only
    # build from PyTorch's index; the lock file deliberately omits torch and
    # the CUDA libraries that PyPI's build would bring.
    "${uv}" venv --python /usr/bin/python3.12 /opt/napari-env
    VIRTUAL_ENV=/opt/napari-env "${uv}" pip install \
        --no-cache --no-deps --compile-bytecode \
        --index-url https://download.pytorch.org/whl/cpu \
        -r /opt/napari-selkies/requirements-torch.txt
    VIRTUAL_ENV=/opt/napari-env "${uv}" pip install \
        --no-cache --no-deps --compile-bytecode \
        -r /opt/napari-selkies/requirements.lock

    # Compatibility patches for the pinned versions (each patch file names
    # the package and version it applies to; see the README for the reasons):
    #   napari-spatialdata 0.7.2   string cell ids on polygons (Xenium v2+)
    #   napari-prism 84a9ad5       matplotlib.cm.get_cmap removed in matplotlib 3.9
    #   PyComplexHeatmap 1.8.5     the same
    #   napari-imc 0.6.6           Qt 5-only signal overload, under PyQt6
    #   napari-metadata 0.5.0      napari 0.10's automatic scale bar font size
    # A patch that no longer applies stops the build, which shows that the
    # package has changed and the patch should be reviewed or removed.
    site_packages=/opt/napari-env/lib/python3.12/site-packages
    for p in /opt/napari-selkies/patches/*.patch; do
        echo "Applying $(basename "${p}")"
        patch -p1 --forward -d "${site_packages}" < "${p}"
    done
    /opt/napari-env/bin/python -m compileall -q -f \
        "${site_packages}/napari_spatialdata/utils" \
        "${site_packages}/napari_prism/pl.py" \
        "${site_packages}/PyComplexHeatmap/utils.py" \
        "${site_packages}/napari_imc/widgets" \
        "${site_packages}/napari_metadata/viewer_widgets"

    # napari-cosmx environment (Bruker Software License Agreement for
    # Non-Commercial Use; a copy is kept beside the environment).
    "${uv}" venv --python /usr/bin/python3.12 /opt/napari-cosmx-env
    VIRTUAL_ENV=/opt/napari-cosmx-env "${uv}" pip install \
        --no-cache --no-deps --compile-bytecode \
        -r /opt/napari-selkies/requirements-cosmx.lock
    cp /opt/napari-cosmx-env/lib/python3.12/site-packages/napari_cosmx-*.dist-info/licenses/LICENSE \
        /opt/napari-cosmx-env/LICENSE-napari-cosmx.txt

    rm -rf /tmp/uv-bootstrap

    # Cellpose model weights. Compute nodes have no internet access, so the
    # model that Cellpose and napari-cellposesam use by default is included;
    # napari-session links it into ~/.cellpose/models.
    install -d -m 0755 /opt/cellpose-models
    for model in {{ CELLPOSE_MODELS }}; do
        curl -fL --retry 3 -o "/opt/cellpose-models/${model}" \
            "https://huggingface.co/mouseland/cellpose-sam/resolve/main/${model}"
        chmod 0644 "/opt/cellpose-models/${model}"
    done
    (cd /opt/cellpose-models && sha256sum * > SHA256SUMS)

    chmod 0755 /opt/napari-selkies/bin/napari-session \
               /opt/napari-selkies/bin/napari-spatialdata-start

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH="/opt/napari-selkies/bin:/opt/napari-env/bin:${PATH}"
    export NAPARI_ENV=/opt/napari-env
    export NAPARI_COSMX_ENV=/opt/napari-cosmx-env
    export CELLPOSE_BUNDLED_MODELS=/opt/cellpose-models
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # None of the image's Python environments may import packages from the
    # user's ~/.local, which is bind-mounted from the host.
    export PYTHONNOUSERSITE=1
    # The image is read-only. Therefore, numba ( used by naapri ) and matplotlib need
    # writable cache locations outside it
    export NUMBA_CACHE_DIR="${TMPDIR:-/tmp}/numba-cache-$(id -u)"
    export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib-$(id -u)"

%runscript
    # Default: a napari-spatialdata session streamed by Selkies; any arguments
    # are passed to selkies-session (for example --port=...).
    exec selkies-session --session=/opt/napari-selkies/bin/napari-session "$@"

%test
    set -e
    command -v selkies-session >/dev/null
    command -v Xvfb >/dev/null
    command -v openbox >/dev/null
    export QT_QPA_PLATFORM=offscreen
    /opt/napari-env/bin/python -c "
import torch, napari, napari_spatialdata, spatialdata, PyQt6.QtCore
assert not torch.version.cuda, 'expected the CPU-only build of PyTorch'
print('napari', napari.__version__, 'napari-spatialdata', napari_spatialdata.__version__, 'torch', torch.__version__)"
    /opt/napari-env/bin/python - <<'PY'
import npe2
pm = npe2.PluginManager.instance()
pm.discover(include_npe1=True)     # napari-image-stacker uses the older plugin system
pm.index_npe1_adapters()
expected = {'napari-spatialdata', 'napari-ome-zarr', 'napari-geojson', 'napari-czi',
            'napari-tiff', 'napari-metadata', 'napari-svg', 'napari-pystackreg',
            'napari-prism', 'napari-imc', 'napari-czitools', 'napari-harpy',
            'napari-cellposesam', 'napari-animation', 'napari-matplotlib',
            'elastix-napari', 'napari-image-stacker'}
found = {m.name for m in pm.iter_manifests()}
missing = sorted(expected - found)
assert not missing, f'plugins not registered: {missing}'
print(f'{len(expected)} requested plugins registered')
PY
    /opt/napari-cosmx-env/bin/python -c "import napari, napari_cosmx; print('napari-cosmx environment: napari', napari.__version__)"
    test -s /opt/cellpose-models/{{ CELLPOSE_MODELS }}

%help
    napari-spatialdata with requested plugins, streamed to the browser by Selkies {{ SELKIES_VERSION }}.
    Image version {{ IMAGE_VERSION }}.

    This image is launched by the Open OnDemand napari-spatialdata app.

    napari alone, displayed through X11 forwarding (software OpenGL):

        apptainer exec --bind /well napari-spatialdata-selkies.sif \
            env LIBGL_ALWAYS_SOFTWARE=1 python -m napari_spatialdata view /path/to/data.zarr
